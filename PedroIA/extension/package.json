{
  "name": "clean-code",
  "displayName": "Clean Code",
  "description": "Assistente de IA para programação no VS Code: chat com contexto, autocomplete inline, ajuda no terminal e comandos para criar, corrigir, refatorar, documentar e revisar código — em qualquer linguagem.",
  "version": "0.2.0",
  "publisher": "pedroia",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "ai",
    "copilot",
    "autocomplete",
    "chat",
    "llm",
    "assistant",
    "clean code",
    "refactor",
    "code review"
  ],
  "icon": "media/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0d1018",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/advdanilomarques-coder/juscall-connect"
  },
  "homepage": "https://github.com/advdanilomarques-coder/juscall-connect/tree/main/PedroIA",
  "bugs": {
    "url": "https://github.com/advdanilomarques-coder/juscall-connect/issues"
  },
  "qna": "marketplace",
  "sponsor": {
    "url": "https://github.com/advdanilomarques-coder"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cleancode-sidebar",
          "title": "Clean Code",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "cleancode-sidebar": [
        {
          "type": "webview",
          "id": "cleancode.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      { "command": "cleancode.openChat", "title": "Abrir Chat", "category": "Clean Code" },
      { "command": "cleancode.askSelection", "title": "Perguntar sobre a seleção", "category": "Clean Code" },
      { "command": "cleancode.create", "title": "Criar projeto / código (/create)", "category": "Clean Code" },
      { "command": "cleancode.explain", "title": "Explicar código (/explain)", "category": "Clean Code" },
      { "command": "cleancode.fix", "title": "Corrigir erro (/fix)", "category": "Clean Code" },
      { "command": "cleancode.refactor", "title": "Refatorar (/refactor)", "category": "Clean Code" },
      { "command": "cleancode.test", "title": "Gerar testes (/test)", "category": "Clean Code" },
      { "command": "cleancode.security", "title": "Análise de segurança (/security)", "category": "Clean Code" },
      { "command": "cleancode.document", "title": "Documentar código (/document)", "category": "Clean Code" },
      { "command": "cleancode.optimize", "title": "Otimizar desempenho (/optimize)", "category": "Clean Code" },
      { "command": "cleancode.review", "title": "Revisão de código (/review)", "category": "Clean Code" },
      { "command": "cleancode.comment", "title": "Comentar o código (/comment)", "category": "Clean Code" },
      { "command": "cleancode.convert", "title": "Converter para outra linguagem (/convert)", "category": "Clean Code" },
      { "command": "cleancode.terminalHelp", "title": "Ajuda com o Terminal", "category": "Clean Code" }
    ],
    "submenus": [
      { "id": "cleancode.submenu", "label": "Clean Code" }
    ],
    "menus": {
      "editor/context": [
        { "submenu": "cleancode.submenu", "group": "navigation@9" }
      ],
      "cleancode.submenu": [
        { "command": "cleancode.askSelection", "group": "1_ask@1" },
        { "command": "cleancode.explain", "group": "2_ai@1" },
        { "command": "cleancode.fix", "group": "2_ai@2" },
        { "command": "cleancode.refactor", "group": "2_ai@3" },
        { "command": "cleancode.document", "group": "2_ai@4" },
        { "command": "cleancode.comment", "group": "2_ai@5" },
        { "command": "cleancode.optimize", "group": "3_adv@1" },
        { "command": "cleancode.review", "group": "3_adv@2" },
        { "command": "cleancode.test", "group": "3_adv@3" },
        { "command": "cleancode.security", "group": "3_adv@4" },
        { "command": "cleancode.convert", "group": "3_adv@5" }
      ],
      "terminal/context": [
        { "command": "cleancode.terminalHelp", "group": "navigation@1" }
      ],
      "commandPalette": [
        { "command": "cleancode.terminalHelp", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "cleancode.openChat", "key": "ctrl+shift+i", "mac": "cmd+shift+i" },
      { "command": "cleancode.askSelection", "key": "ctrl+l", "mac": "cmd+l", "when": "editorTextFocus" },
      { "command": "cleancode.terminalHelp", "key": "ctrl+alt+t", "mac": "cmd+alt+t", "when": "terminalFocus" }
    ],
    "configuration": {
      "title": "Clean Code",
      "properties": {
        "cleancode.backendUrl": {
          "type": "string",
          "default": "https://pedroia-backend.onrender.com",
          "description": "URL do servidor Clean Code (backend de IA)."
        },
        "cleancode.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Chave de acesso ao servidor Clean Code. Obrigatória quando o servidor exige autenticação."
        },
        "cleancode.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar o autocomplete inline (sugestões em texto cinza, estilo Copilot)."
        },
        "cleancode.completion.debounceMs": {
          "type": "number",
          "default": 350,
          "description": "Tempo de espera (ms) antes de solicitar uma sugestão de autocomplete."
        },
        "cleancode.preferredMode": {
          "type": "string",
          "enum": ["auto", "cloud", "local"],
          "default": "auto",
          "description": "Estratégia de modelo: auto (nuvem quando online, local quando offline), cloud ou local."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node ./esbuild.js --production",
    "esbuild": "node ./esbuild.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  }
}
