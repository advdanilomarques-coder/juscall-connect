# ---- PedroIA backend configuration ----
# Copie para .env e ajuste. Todos os provedores de IA são OPCIONAIS:
# sem nenhuma chave e sem Ollama, o backend ainda roda em "modo de configuração".

ENVIRONMENT=development
DEBUG=true

# CORS (lista separada por vírgula ou * )
# CORS_ORIGINS=["*"]

# ---- Auth (opcional). Vazio = modo local aberto. ----
# API_KEYS=chave-secreta-1,chave-secreta-2

# ---- Login do site (JWT). Em produção, defina um segredo forte! ----
# JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio
# JWT_EXPIRE_MINUTES=10080
# ALLOW_SIGNUP=true

# ---- Banco de dados ----
# Padrão SQLite (zero configuração):
DATABASE_URL=sqlite+aiosqlite:///./pedroia.db
# PostgreSQL (produção):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pedroia

REDIS_URL=redis://localhost:6379/0

# ---- Provedores de nuvem (defina pelo menos um para respostas reais) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Groq — plano gratuito generoso, sem exigir cartão (https://console.groq.com/keys)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Modo offline (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_COMPLETION_MODEL=qwen2.5-coder:1.5b
