# ======================================================================
# PedroIA backend — variáveis de ambiente (EXEMPLO)
# Copie este arquivo para ".env" e preencha os valores.
# ======================================================================

# (OBRIGATÓRIO) Sua chave da Anthropic. Pegue em: https://console.anthropic.com/settings/keys
# Formato: sk-ant-api03-...
ANTHROPIC_API_KEY=

# (OBRIGATÓRIO EM PRODUÇÃO) Chaves de acesso da extensão, separadas por vírgula.
# Os usuários da extensão precisam enviar uma delas. Sem isso, o servidor não sobe em produção.
# Gere uma chave aleatória forte, ex.: openssl rand -hex 24
API_KEYS=

# (opcional) Modelo do Claude. Padrão: claude-opus-5
PEDROIA_MODEL=claude-opus-5

# (opcional) Máximo de tokens por resposta do chat. Padrão: 4096
PEDROIA_MAX_TOKENS=4096

# (opcional) Rate limiting — requisições por janela, por IP. Padrão: 3 a cada 60s
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=60000

# (opcional) Porta. O Render define automaticamente; localmente usa 8787.
PORT=8787

# Ambiente. Em produção, use "production" (ativa a trava de segurança do API_KEYS).
NODE_ENV=development
