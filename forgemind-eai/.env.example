# ============================================================
# ForgeMind EAI — configuracao de ambiente (EXEMPLO)
# Copie para `.env` e ajuste. NUNCA versione o `.env` real.
# ============================================================

# ---- Provider de IA ----
# offline-first: o padrao NAO usa internet e NAO usa Ollama.
#   heuristic   -> 100% offline, sem modelo, sem download (padrao)
#   local-llama -> offline, modelo GGUF local via node-llama-cpp (opcional)
#   gemini      -> online (Google Gemini API) — desligado por padrao
AI_PROVIDER=heuristic

# ---- Local Llama (opcional, apenas se AI_PROVIDER=local-llama) ----
# Modelo GGUF local (baixado UMA vez, com internet; depois 100% offline).
# Recomendado p/ Mac Intel antigo com ~10GB RAM: Qwen2.5-3B (assuntos gerais + codigo + PT-BR).
# Use `./scripts/model-pull.sh` para baixar. Modo rapido: troque para o 1.5B.
LOCAL_MODEL_PATH=./models/qwen2.5-3b-instruct-q4_k_m.gguf
LOCAL_MODEL_CONTEXT=4096
LOCAL_MODEL_THREADS=4

# ---- Gemini (opcional, apenas se AI_PROVIDER=gemini) ----
# A chave fica SO no backend, nunca no frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Servidor local ----
# O ForgeMind escuta APENAS em localhost. Nao hospeda nada externamente.
FORGEMIND_HOST=127.0.0.1
FORGEMIND_PORT=4319

# ---- Dados locais ----
# Diretorio de dados (SQLite, logs, backups). Padrao: ~/.forgemind
FORGEMIND_HOME=

# ---- Inline / Ghost Text ----
# OFF | LOW | BALANCED | HIGH
INLINE_LEVEL=BALANCED
INLINE_DEBOUNCE_MS=350
INLINE_MIN_CONFIDENCE=0.35
