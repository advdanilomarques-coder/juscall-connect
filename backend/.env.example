# ============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE — MARQUES IA (Backend)
# ----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com seus valores reais.
# NUNCA comite o arquivo `.env` (ele contém segredos). Veja o .gitignore.
#
#   cp .env.example .env
# ============================================================================

# --- Identificação da aplicação ---
APP_NAME="Marques IA"
APP_ENV="development"          # development | production
DEBUG="true"

# --- Escritório (usado nos contratos e nas mensagens do agente) ---
FIRM_NAME="Marques Advogados Associados"
FIRM_LAWYER="Dr. Marques"
FIRM_OAB="OAB/XX 000000"
FIRM_CITY="São Paulo/SP"

# ============================================================================
# CAMADA DE IA (AI Provider Layer)
# ============================================================================
# Chaves das APIs. Preencha apenas os provedores que for usar — os demais
# ficam automaticamente "indisponíveis" e são pulados no failover.

# Google Gemini — camada GRATUITA (sem cartão). https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Claude (Anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# OpenAI (GPT) — https://platform.openai.com/
OPENAI_API_KEY=""
# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=""
# Mistral AI — https://console.mistral.ai/
MISTRAL_API_KEY=""
# OpenRouter (roteador para dezenas de modelos) — https://openrouter.ai/
OPENROUTER_API_KEY=""
# Grok (xAI) — https://x.ai/api
GROK_API_KEY=""
# Ollama (modelos locais) — não precisa de chave, apenas o servidor rodando.
OLLAMA_BASE_URL="http://localhost:11434"

# --- Seleção e ordem de failover dos provedores ---
# O sistema tenta os provedores nesta ordem. Se o primeiro falhar, alterna
# automaticamente para o próximo (o cliente nunca percebe a troca).
AI_PROVIDER_ORDER="claude,gemini,openai"

# --- Modelos específicos por provedor ---
GEMINI_MODEL="gemini-2.0-flash"
CLAUDE_MODEL="claude-opus-4-8"
OPENAI_MODEL="gpt-4o"
DEEPSEEK_MODEL="deepseek-chat"
MISTRAL_MODEL="mistral-large-latest"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
GROK_MODEL="grok-2-latest"
OLLAMA_MODEL="llama3.1"

# --- Roteamento inteligente por tipo de tarefa (opcional) ---
# Formato: "tarefa:provedor". Tarefas sem regra usam a ordem padrão acima.
# Tarefas: atendimento | analise_juridica | resumo | leitura_documento | contrato
AI_TASK_ROUTING="atendimento:claude,analise_juridica:openai,resumo:gemini"

# --- Parâmetros de geração e resiliência ---
AI_MAX_TOKENS="1024"
AI_MAX_RETRIES="2"             # tentativas por provedor antes do failover
AI_RETRY_BACKOFF="0.5"         # segundos (base do backoff exponencial)

# ============================================================================
# BANCO DE DADOS (memória persistente + CRM)
# ============================================================================
# Padrão local (SQLite — não precisa instalar nada):
DATABASE_URL="sqlite+aiosqlite:///./storage/marques_ia.db"
# Em produção, troque por PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/marques_ia"

# ============================================================================
# SEGURANÇA (painel administrativo)
# ============================================================================
# Chave para assinar os tokens JWT. GERE UMA ALEATÓRIA em produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="troque-esta-chave-em-producao"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="720"       # validade do token (12h)

# Administrador padrão criado automaticamente na 1ª execução.
ADMIN_DEFAULT_EMAIL="admin@marquesadvogados.com.br"
ADMIN_DEFAULT_PASSWORD="troque-esta-senha"
ADMIN_DEFAULT_NAME="Administrador"

# Rate limit da API pública (requisições por minuto por IP).
RATE_LIMIT_PER_MINUTE="60"

# ============================================================================
# WHATSAPP BUSINESS CLOUD API (Meta) — OPCIONAL para subir o sistema
# ----------------------------------------------------------------------------
# O backend SOBE e funciona (login, painel, IA, CRM, contratos) mesmo com
# estes campos em branco. Preencha só quando for conectar o WhatsApp real.
# ============================================================================
WHATSAPP_TOKEN=""                 # token de acesso da API (Meta for Developers)
WHATSAPP_PHONE_NUMBER=""          # número exibido, ex.: 5511991537423 (informativo)
WHATSAPP_PHONE_NUMBER_ID=""       # ID do número (usado no envio de mensagens)
WHATSAPP_VERIFY_TOKEN="token-de-verificacao-do-webhook"  # você define; use igual no Meta
WHATSAPP_BUSINESS_ACCOUNT_ID=""   # ID da conta WhatsApp Business (WABA)
WHATSAPP_APP_SECRET=""            # segredo do app (valida a assinatura dos webhooks)
WHATSAPP_API_BASE="https://graph.facebook.com/v21.0"

# --- Armazenamento de documentos enviados pelos clientes ---
STORAGE_DIR="./storage/documents"

# --- Logs ---
LOG_LEVEL="INFO"              # DEBUG | INFO | WARNING | ERROR
