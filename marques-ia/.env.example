# ============================================================
# Marques IA — Configuração única do projeto (Backend + IA)
# Copie este arquivo para ".env" e preencha os valores abaixo.
# Nenhum outro arquivo precisa ser editado para instalar/rodar o sistema.
# ============================================================

# ---- Aplicação ----
APP_NAME=Marques IA
ENVIRONMENT=development
SECRET_KEY=troque_por_uma_chave_secreta_aleatoria_bem_longa
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Banco de Dados (PostgreSQL) ----
POSTGRES_USER=marques_ia
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=marques_ia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Deve refletir os valores acima:
DATABASE_URL=postgresql+psycopg2://marques_ia:troque_esta_senha@localhost:5432/marques_ia

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- IA — ÚNICA chave de API (OpenRouter, modelos gratuitos) ----
OPENROUTER_API_KEY=coloque_aqui_sua_unica_chave_gratuita
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRIMARY=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL_FALLBACK_1=qwen/qwen-2.5-7b-instruct:free
OPENROUTER_MODEL_FALLBACK_2=mistralai/mistral-7b-instruct:free

# ---- WhatsApp Business Cloud API ----
WHATSAPP_TOKEN=token_de_acesso_permanente
WHATSAPP_PHONE_NUMBER=5511991537423
WHATSAPP_PHONE_NUMBER_ID=id_do_numero
WHATSAPP_VERIFY_TOKEN=defina_um_token_de_verificacao
WHATSAPP_BUSINESS_ACCOUNT_ID=id_da_conta_business
# App Secret do app da Meta — usado para validar a assinatura do webhook (X-Hub-Signature-256).
# Sem ele, a validação de segurança do webhook fica desativada.
WHATSAPP_APP_SECRET=app_secret_do_seu_app_meta

# ---- E-mail (SMTP) — envio automático de contratos ao cliente (OPCIONAL) ----
# Deixe SMTP_HOST em branco para desativar o envio de e-mail (o sistema continua
# funcionando). Exemplo para Gmail: crie uma "Senha de app" em
# https://myaccount.google.com/apppasswords e use-a em SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Marques Advogados Associados
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---- Administrador padrão (criado automaticamente na 1ª execução) ----
ADMIN_DEFAULT_EMAIL=admin@marquesadvogados.com.br
ADMIN_DEFAULT_PASSWORD=troque_esta_senha_admin
ADMIN_DEFAULT_NAME=Administrador
